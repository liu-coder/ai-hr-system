# 与 E:\workspace\docker\docker-compose.base.yml（及同目录 docker-compose.yml 中的 RocketMQ）中的镜像保持一致。
# 使用方式：docker compose --env-file docker/base-images.env -f ... up --build
#
# --- 以下为 workspace 编排中的镜像（仅作文档对照，修改时请同步 E:\workspace\docker 下 yml）---
# etcd:     quay.io/coreos/etcd:v3.5.12
# minio:    minio/minio:RELEASE.2024-01-11T07-46-16Z
# redis:    redis:7.2.4-alpine
# mysql:    mysql:8.0
# milvus:   milvusdb/milvus:v2.4.6
# rocketmq: apache/rocketmq:5.3.2  （见本仓库 docker/infra-rocketmq.yml）
#
# 业务 JAR 运行时基镜像（base 栈未定义 JDK，沿用官方；可通过此处覆盖为私有仓库地址）
BASE_JAVA_IMAGE=eclipse-temurin:17-jre
# 前端开发镜像（与 Dockerfile.dev 一致，可改为内网镜像）
NODE_IMAGE=node:20-alpine
# workspace 根路径（供脚本 include 使用）
WORKSPACE_DOCKER=E:/workspace/docker
